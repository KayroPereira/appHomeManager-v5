<?xml version="1.0" encoding="utf-8"?>
<!-- Indicador do resumo do dashboard: título, valor grande e uma linha de apoio. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:layout_weight="1"
    android:background="@drawable/bg_card_vidro"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvDtTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="@color/textoSecundario"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDtValor"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="1"
        android:textColor="@android:color/background_light"
        android:textSize="28sp" />

    <TextView
        android:id="@+id/tvDtApoio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/textoSecundario"
        android:textSize="12sp" />
</LinearLayout>
