<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="10dp"
    android:background="@drawable/bg_campo"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">

    <!-- Nome do item com as ações (mover e remover) na mesma linha -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etItemNome"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:autofillHints="none"
            android:background="@null"
            android:hint="@string/nomeItem"
            android:inputType="textCapSentences"
            android:maxLength="30"
            android:minHeight="40dp"
            android:singleLine="true"
            android:textColor="@android:color/background_light"
            android:textColorHint="#80FFFFFF"
            android:textSize="16sp" />

        <ImageView
            android:id="@+id/ivItemSobe"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/moverParaCima"
            android:padding="10dp"
            android:src="@android:drawable/arrow_up_float"
            app:tint="#B3FFFFFF" />

        <ImageView
            android:id="@+id/ivItemDesce"
            android:layout_width="40dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/moverParaBaixo"
            android:padding="10dp"
            android:src="@android:drawable/arrow_down_float"
            app:tint="#B3FFFFFF" />

        <ImageView
            android:id="@+id/ivItemRemover"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/excluir"
            android:padding="10dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="#FF8A80" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvItemTuya"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:paddingEnd="6dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvItemInverter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:paddingEnd="6dp"
        android:textColor="#B3FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvItemCena"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:paddingEnd="6dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvItemCenaParar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:paddingEnd="6dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvItemCenaExtra1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:paddingEnd="6dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvItemCenaExtra2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:paddingEnd="6dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvItemCenaExtra3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:paddingEnd="6dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvItemCenaExtra4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:paddingEnd="6dp"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvItemCenaDesliga"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:minHeight="36dp"
        android:paddingEnd="6dp"
        android:textSize="14sp" />
</LinearLayout>
