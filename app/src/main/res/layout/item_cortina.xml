<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="5dp">

    <LinearLayout
        android:id="@+id/llCortina"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_card_vidro"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:importantForAccessibility="no"
                app:srcCompat="@drawable/ic_cortina"
                app:tint="@color/corCortina" />

            <TextView
                android:id="@+id/tvCortinaNome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@android:color/background_light"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvCortinaEstado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_status"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp"
                android:textColor="@color/corCortina"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Posição da cortina quando o motor informa. -->
        <LinearLayout
            android:id="@+id/llCortinaBarra"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_barra_posicao"
            android:orientation="horizontal"
            android:visibility="invisible"
            android:weightSum="100">

            <View
                android:id="@+id/vCortinaPreenchida"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_barra_posicao_cheia" />
        </LinearLayout>

        <!-- Subir, parar e descer numa barra só. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_segmentado"
            android:orientation="horizontal"
            android:padding="4dp">

            <FrameLayout
                android:id="@+id/llCortinaSubir"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/subir"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:padding="6dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_subir" />
            </FrameLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:background="#33FFFFFF" />

            <FrameLayout
                android:id="@+id/llCortinaParar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/parar"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:padding="6dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_parar" />
            </FrameLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:background="#33FFFFFF" />

            <FrameLayout
                android:id="@+id/llCortinaDescer"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="@string/descer"
                android:foreground="?attr/selectableItemBackground">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:padding="6dp"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_descer" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
