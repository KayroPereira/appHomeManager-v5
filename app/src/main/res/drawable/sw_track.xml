<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:state_enabled="false">
        <shape android:shape="rectangle">
            <size android:width="40dp" android:height="20dp" />
            <solid android:color="#5929B6F6" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_checked="false" android:state_enabled="false">
        <shape android:shape="rectangle">
            <size android:width="40dp" android:height="20dp" />
            <solid android:color="#26FFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <size android:width="40dp" android:height="20dp" />
            <solid android:color="#29B6F6" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <size android:width="40dp" android:height="20dp" />
            <solid android:color="#4DFFFFFF" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</selector>
