<?xml version="1.0" encoding="utf-8"?>
<!-- Folha de caderno: sombra, papel, pautas azuis, margem vermelha e espiral à esquerda. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="2dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <solid android:color="#59000000" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:right="3dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#FFF3EFE2"
                android:startColor="#FFFFFDF5" />
            <corners android:radius="4dp" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:right="3dp"
        android:top="28dp">
        <bitmap
            android:src="@drawable/linha_caderno"
            android:tileModeX="repeat"
            android:tileModeY="repeat" />
    </item>
    <item
        android:bottom="3dp"
        android:gravity="left"
        android:left="46dp"
        android:width="2dp">
        <shape android:shape="rectangle">
            <solid android:color="#B0E57373" />
        </shape>
    </item>
    <item
        android:bottom="3dp"
        android:gravity="left|fill_vertical"
        android:top="4dp"
        android:width="36dp">
        <bitmap
            android:gravity="fill_vertical|left"
            android:src="@drawable/espiral_caderno"
            android:tileModeY="repeat" />
    </item>
</layer-list>
